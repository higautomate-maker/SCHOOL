# Database-container-only secrets. Copy to .env.production.postgres (mode 0600).
# Generate three different random secrets; do not reuse Neon or staging passwords.
POSTGRES_DB=hig_school_production
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-unique-superuser-secret
HIG_PRODUCTION_OWNER_PASSWORD=replace-with-a-unique-migration-owner-secret
HIG_PRODUCTION_APP_PASSWORD=replace-with-a-unique-runtime-secret
