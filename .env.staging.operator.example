# Operator-only staging secret. Copy to .env.staging.operator, chmod 0600,
# and never pass this file to the app or worker containers.
# It must target the same staging host/database as DATABASE_URL but use a
# different migration-owner role.
MIGRATION_DATABASE_URL=postgresql://staging_school_owner:replace-me@staging-postgres.example.com:5432/staging_school?sslmode=verify-full
