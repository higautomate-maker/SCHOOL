# Copy into Hostinger staging only. Never upload this template as a production environment.
NODE_ENV=production
HIG_RUNTIME=node
HIG_DEPLOYMENT_ENV=staging
HIG_STAGING_NAME=staging-school
HIG_STAGING_PROTECTION=STAGING_ONLY
HIG_STAGING_REQUIRE_EMPTY=true

APP_URL=https://staging-school.example.com
PORT=3000
SESSION_SECRET=replace-with-a-unique-32-byte-staging-secret
HIG_SECURITY_HASH_KEY=replace-with-a-different-32-byte-staging-hash-key

# Least-privilege runtime role only: NOSUPERUSER and NOBYPASSRLS.
# Put the separate migration-owner URL in .env.staging.operator, never here.
DATABASE_URL=postgresql://staging_school_app:replace-me@staging-postgres.example.com:5432/staging_school?sslmode=verify-full
PG_SSL=require
PG_POOL_MAX=8
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=10000

REDIS_URL=rediss://staging-school:replace-me@staging-redis.example.com:6380
HIG_REDIS_NAMESPACE=staging-school:
HIG_QUEUE_MODE=redis

HIG_REPOSITORY_BACKEND=postgres
HIG_POSTGRES_SHADOW_READS=false
HIG_KEY_PROVIDER=environment
HIG_ENCRYPTION_KEY=replace-with-a-different-32-byte-staging-key
HIG_SALES_DEMO=false
HIG_EMAIL_ADAPTER=smtp
SMTP_URL=smtps://staging-user:replace-me@staging-smtp.example.com:465
SMTP_FROM=HIG School Staging <security-staging@example.com>

HIG_STAGING_STORAGE_PATH=/data/staging-school
HIG_STAGING_LOG_PATH=/logs/staging-school
HIG_STAGING_BACKUP_PATH=/backups/staging-school
LOG_LEVEL=info

# Required only by the Stage 7 staging smoke command. The password file must
# be mode 0600 and mounted in the operator container; never put its contents
# in this environment file.
HIG_STAGING_PLATFORM_AUTH_EMAIL=staging.platform@higschool.test
HIG_STAGING_PLATFORM_PASSWORD_FILE=/backups/staging-school/stage7-platform-password
HIG_STAGING_SCHOOL_AUTH_EMAIL=staging.school@higschool.test
HIG_STAGING_SCHOOL_PASSWORD_FILE=/backups/staging-school/stage7-school-password

# Non-secret UUID of the synthetic primary staging school. Required only by
# the bounded staging load rehearsal after staging initialization.
HIG_LOAD_TENANT_ID=

# Stage 8 notification worker. Capture is permitted only in isolated staging;
# keep these disabled unless a bounded delivery-capture rehearsal is required.
HIG_QUEUE_WORKER_ENABLED=true
HIG_QUEUE_BATCH_SIZE=20
HIG_QUEUE_CONCURRENCY=4
HIG_QUEUE_POLL_INTERVAL_MS=5000
HIG_QUEUE_LEASE_SECONDS=120
HIG_QUEUE_MAX_ATTEMPTS=6
HIG_QUEUE_RETRY_BASE_MS=5000
HIG_QUEUE_RETRY_MAX_MS=900000
HIG_QUEUE_HEARTBEAT_PATH=/logs/staging-school/notification-worker-heartbeat.json
HIG_QUEUE_HEARTBEAT_MAX_AGE_MS=90000
HIG_NOTIFICATION_EMAIL_ADAPTER=disabled
HIG_SMS_ADAPTER=disabled
HIG_PUSH_ADAPTER=disabled
HIG_NOTIFICATION_CAPTURE_PATH=/logs/staging-school/notification-capture.jsonl
