# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.staging.example
!.env.staging.operator.example
!.env.production.example
!.env.production.operator.example

# vercel
.vercel

# typescript
next-env.d.ts
*.tsbuildinfo
/dist/
/.wrangler/
/outputs/
/work/
/.data/

# generated release bundles and local packaging artifacts
/release/
*.zip
*.tar.gz
/hig-school-hostinger-node-fixed*/

# Flutter release credentials and generated platform state
**/google-services.json
**/GoogleService-Info.plist
**/*.jks
**/*.keystore
**/key.properties
**/.dart_tool/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/build/
