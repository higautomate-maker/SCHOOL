{
  "version": 2,
  "scope": "stage9_mobile_app_completion",
  "webAuthentication": {
    "unchanged": true,
    "actorTypes": [
      "platform",
      "school"
    ],
    "sessionTransport": "secure_cookie",
    "unsafeRequestProtection": [
      "same_origin",
      "csrf"
    ]
  },
  "mobileAuthentication": {
    "separateFromWebSessions": true,
    "sessionTransport": "opaque_bearer_tokens",
    "accessTokenTtlSeconds": 900,
    "refreshTokenTtlSeconds": 2592000,
    "tokenEntropyBytes": 32,
    "tokenStorage": "sha256_hash_only",
    "refreshRotation": "every_successful_use",
    "refreshReplayAction": "revoke_token_family",
    "credentialVersionRequired": true,
    "rawTokensMayBeLogged": false
  },
  "principalTypes": [
    "school",
    "parent",
    "student",
    "transporter"
  ],
  "authorizationOrder": {
    "school": [
      "authenticated_mobile_session",
      "client_identity_type",
      "active_school_membership",
      "exact_tenant_match",
      "company_module_entitlement",
      "school_role_permission",
      "resource_assignment"
    ],
    "parent": [
      "authenticated_mobile_session",
      "client_identity_type",
      "active_mobile_relationship",
      "exact_tenant_match",
      "company_app_feature",
      "required_school_module",
      "resource_assignment"
    ],
    "student": [
      "authenticated_mobile_session",
      "client_identity_type",
      "active_mobile_relationship",
      "exact_tenant_match",
      "company_app_feature",
      "required_school_module",
      "resource_assignment"
    ],
    "transporter": [
      "authenticated_mobile_session",
      "client_identity_type",
      "active_mobile_relationship",
      "exact_tenant_match",
      "company_app_feature",
      "required_school_module",
      "resource_assignment"
    ]
  },
  "endpoints": [
    {
      "id": "mobile.auth.login",
      "file": "app/api/v1/mobile/auth/login/route.ts",
      "method": "POST",
      "authentication": "public_credentials",
      "rateLimited": true,
      "createsCookies": false,
      "idempotency": "not_applicable",
      "batch": 1
    },
    {
      "id": "mobile.auth.refresh",
      "file": "app/api/v1/mobile/auth/refresh/route.ts",
      "method": "POST",
      "authentication": "refresh_token",
      "rateLimited": true,
      "createsCookies": false,
      "idempotency": "atomic_rotation",
      "batch": 1
    },
    {
      "id": "mobile.auth.logout",
      "file": "app/api/v1/mobile/auth/logout/route.ts",
      "method": "POST",
      "authentication": "access_bearer",
      "rateLimited": true,
      "createsCookies": false,
      "idempotency": "safe_repeat",
      "batch": 1
    },
    {
      "id": "mobile.session.view",
      "file": "app/api/v1/mobile/session/route.ts",
      "method": "GET",
      "authentication": "access_bearer",
      "rateLimited": false,
      "createsCookies": false,
      "idempotency": "not_applicable",
      "batch": 1
    },
    {
      "id": "mobile.access.view",
      "file": "app/api/v1/mobile/access/route.ts",
      "method": "GET",
      "authentication": "access_bearer",
      "rateLimited": false,
      "createsCookies": false,
      "acceptsTenantOverride": false,
      "acceptsAudienceOverride": false,
      "idempotency": "not_applicable",
      "batch": 1
    },
    {
      "id": "mobile.home.view",
      "file": "app/api/v1/mobile/home/route.ts",
      "method": "GET",
      "authentication": "access_bearer",
      "rateLimited": false,
      "createsCookies": false,
      "acceptsTenantOverride": false,
      "acceptsAudienceOverride": false,
      "idempotency": "not_applicable",
      "batch": 2
    },
    {
      "id": "mobile.operations.view",
      "file": "app/api/v1/mobile/operations/route.ts",
      "method": "GET",
      "authentication": "access_bearer",
      "rateLimited": false,
      "createsCookies": false,
      "idempotency": "not_applicable",
      "batch": 2
    },
    {
      "id": "mobile.operations.manage",
      "file": "app/api/v1/mobile/operations/route.ts",
      "method": "POST",
      "authentication": "access_bearer",
      "rateLimited": false,
      "createsCookies": false,
      "idempotency": "required_key",
      "batch": 2
    },
    {
      "id": "mobile.content.view",
      "file": "app/api/v1/mobile/content/route.ts",
      "method": "GET",
      "authentication": "access_bearer",
      "rateLimited": false,
      "createsCookies": false,
      "acceptsTenantOverride": false,
      "acceptsAudienceOverride": false,
      "idempotency": "not_applicable",
      "batch": 2
    },
    {
      "id": "mobile.content.manage",
      "file": "app/api/v1/mobile/content/route.ts",
      "method": "POST",
      "authentication": "access_bearer",
      "rateLimited": false,
      "createsCookies": false,
      "idempotency": "client_queue_or_server_action",
      "batch": 2
    },
    {
      "id": "mobile.notifications.view",
      "file": "app/api/v1/mobile/notifications/route.ts",
      "method": "GET",
      "authentication": "access_bearer",
      "rateLimited": false,
      "createsCookies": false,
      "idempotency": "not_applicable",
      "batch": 2
    },
    {
      "id": "mobile.notifications.read",
      "file": "app/api/v1/mobile/notifications/[notificationId]/read/route.ts",
      "method": "POST",
      "authentication": "access_bearer",
      "rateLimited": false,
      "createsCookies": false,
      "idempotency": "safe_repeat",
      "batch": 2
    },
    {
      "id": "mobile.devices.register",
      "file": "app/api/v1/mobile/devices/route.ts",
      "method": "PUT",
      "authentication": "access_bearer",
      "rateLimited": false,
      "createsCookies": false,
      "idempotency": "token_hash_upsert",
      "batch": 2
    },
    {
      "id": "mobile.devices.revoke",
      "file": "app/api/v1/mobile/devices/route.ts",
      "method": "DELETE",
      "authentication": "access_bearer",
      "rateLimited": false,
      "createsCookies": false,
      "idempotency": "safe_repeat",
      "batch": 2
    },
    {
      "id": "mobile.transport.view",
      "file": "app/api/v1/mobile/transport/route.ts",
      "method": "GET",
      "authentication": "access_bearer",
      "rateLimited": false,
      "createsCookies": false,
      "idempotency": "not_applicable",
      "batch": 2
    },
    {
      "id": "mobile.transport.events.create",
      "file": "app/api/v1/mobile/transport/events/route.ts",
      "method": "POST",
      "authentication": "access_bearer",
      "rateLimited": false,
      "createsCookies": false,
      "idempotency": "required_key",
      "batch": 2
    }
  ],
  "tables": [
    {
      "name": "mobile_identities",
      "tenantScoped": true,
      "forceRls": true,
      "authenticationServicePolicyRequired": true
    },
    {
      "name": "mobile_identity_assignments",
      "tenantScoped": true,
      "forceRls": true,
      "authenticationServicePolicyRequired": true
    },
    {
      "name": "mobile_sessions",
      "tenantScoped": true,
      "forceRls": true,
      "authenticationServicePolicyRequired": true
    },
    {
      "name": "mobile_refresh_token_uses",
      "tenantScoped": true,
      "forceRls": true,
      "authenticationServicePolicyRequired": true
    },
    {
      "name": "mobile_token_locators",
      "tenantScoped": false,
      "forceRls": true,
      "authenticationServicePolicyRequired": true,
      "purpose": "opaque_token_to_tenant_locator_only"
    },
    {
      "name": "mobile_device_registrations",
      "tenantScoped": true,
      "forceRls": true,
      "authenticationServicePolicyRequired": true,
      "purpose": "encrypted_push_provider_registration"
    },
    {
      "name": "mobile_transport_events",
      "tenantScoped": true,
      "forceRls": true,
      "authenticationServicePolicyRequired": true,
      "purpose": "foreground_stage9_transport_event_log"
    }
  ],
  "securityEvents": [
    "mobile.auth.login.success",
    "mobile.auth.login.failure",
    "mobile.auth.refresh.success",
    "mobile.auth.refresh.failure",
    "mobile.auth.refresh.replay",
    "mobile.auth.logout",
    "mobile.auth.session.revoked"
  ],
  "deferred": [
    "mobile_account_provisioning_ui",
    "remote_push_provider_credentials",
    "background_location_tracking",
    "geofencing_and_parent_live_map",
    "location_retention_automation",
    "store_signing_and_submission",
    "staging_migration",
    "staging_deployment"
  ]
}
