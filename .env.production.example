# Production runtime only. Copy to .env.production, chmod 0600 and replace
# every placeholder outside Git. Never reuse staging credentials or resources.
NODE_ENV=production
HIG_RUNTIME=node
HIG_DEPLOYMENT_ENV=production

APP_URL=https://school.higaai.com
PORT=3000
SESSION_SECRET=replace-with-a-unique-32-byte-production-session-secret
HIG_SECURITY_HASH_KEY=replace-with-a-different-32-byte-production-hash-key

# Least-privilege runtime role only. Use a pooled Neon connection if selected.
# The migration-owner URL belongs only in .env.production.operator.
DATABASE_URL=postgresql://hig_school_production_app:replace-me@production-postgres.example.com:5432/hig_school_production?sslmode=verify-full
PG_SSL=require
PG_POOL_MAX=8
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=10000

REDIS_URL=rediss://hig-school-production:replace-me@production-redis.example.com:6380
HIG_REDIS_NAMESPACE=hig-school-production:
HIG_QUEUE_MODE=redis

HIG_REPOSITORY_BACKEND=postgres
HIG_POSTGRES_SHADOW_READS=false
HIG_KEY_PROVIDER=environment
HIG_ENCRYPTION_KEY=replace-with-a-different-32-byte-production-encryption-key
HIG_SALES_DEMO=false

# Real providers must replace disabled adapters before Stage 14 launch.
HIG_EMAIL_ADAPTER=smtp
SMTP_URL=smtps://production-user:replace-me@production-smtp.example.com:465
SMTP_FROM=HIG School <security@example.com>
HIG_NOTIFICATION_EMAIL_ADAPTER=disabled
HIG_SMS_ADAPTER=disabled
HIG_PUSH_ADAPTER=disabled

HIG_QUEUE_WORKER_ENABLED=true
HIG_QUEUE_BATCH_SIZE=20
HIG_QUEUE_CONCURRENCY=4
HIG_QUEUE_POLL_INTERVAL_MS=5000
HIG_QUEUE_LEASE_SECONDS=120
HIG_QUEUE_MAX_ATTEMPTS=6
HIG_QUEUE_RETRY_BASE_MS=5000
HIG_QUEUE_RETRY_MAX_MS=900000
HIG_QUEUE_HEARTBEAT_PATH=/logs/hig-school-production/notification-worker-heartbeat.json
HIG_QUEUE_HEARTBEAT_MAX_AGE_MS=90000
LOG_LEVEL=info
