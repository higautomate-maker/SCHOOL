# Operator-only production secret. Copy to .env.production.operator, chmod
# 0600 and never load it into app or worker containers.
MIGRATION_DATABASE_URL=postgresql://hig_school_production_owner:replace-me@production-postgres.example.com:5432/hig_school_production?sslmode=verify-full

# Required only for the deliberate Stage 13 migration command. Remove it from
# the file immediately after Stage 13 closes.
HIG_PRODUCTION_CUTOVER_APPROVED=GREENFIELD_POSTGRES_CUTOVER
