{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "build:hostinger": "HIG_RUNTIME=node WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "node --experimental-strip-types scripts/validate-production-environment.ts && WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run test:unit",
    "test:unit": "NODE_ENV=test HIG_SALES_DEMO=true node --experimental-strip-types --test tests/*.test.ts",
    "test:integration:infra": "node scripts/test-integration-infra.mjs",
    "test:integration:auth": "node --experimental-strip-types scripts/test-auth-integration.ts",
    "test:integration:hostinger": "node scripts/test-hostinger-container.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build",
    "security:secrets": "node scripts/check-secrets.mjs",
    "security:licenses": "node scripts/check-licenses.mjs",
    "sbom": "npm sbom --sbom-format cyclonedx",
    "db:generate": "drizzle-kit generate",
    "db:pg:generate": "drizzle-kit generate --config drizzle.postgres.config.ts",
    "db:pg:migrate": "node scripts/migrate-postgres.mjs",
    "db:pg:migrate:check": "node scripts/migrate-postgres.mjs --check",
    "db:pg:backup:validate": "node scripts/validate-postgres-backup.mjs",
    "db:migrate:dry-run": "node --experimental-strip-types scripts/migrate-sqlite-to-postgres.ts",
    "db:migrate:execute": "node --experimental-strip-types scripts/migrate-sqlite-to-postgres.ts --execute",
    "db:reconcile": "node --experimental-strip-types scripts/reconcile-sqlite-postgres.ts",
    "test:load:postgres": "node --experimental-strip-types scripts/test-postgres-load.ts",
    "test:readiness:production": "node --experimental-strip-types scripts/test-stage5-readiness.ts",
    "validate:production": "node --experimental-strip-types scripts/validate-production-environment.ts",
    "staging:validate": "node --experimental-strip-types scripts/validate-staging-environment.ts",
    "staging:migrate": "node --experimental-strip-types scripts/migrate-staging-postgres.ts",
    "staging:initialize": "node --experimental-strip-types scripts/initialize-staging-greenfield.ts",
    "staging:smoke": "node --experimental-strip-types scripts/test-staging-smoke.ts",
    "staging:isolation": "node --experimental-strip-types scripts/test-staging-isolation.ts",
    "staging:load": "node --experimental-strip-types scripts/test-staging-load.ts",
    "staging:backup:restore": "node --experimental-strip-types scripts/test-staging-backup-restore.ts",
    "staging:rollback:verify": "node --experimental-strip-types scripts/test-staging-rollback.ts",
    "staging:audit": "node scripts/review-dependency-audit.mjs",
    "db:pg:check": "node --experimental-strip-types --test tests/postgres-foundation.test.ts",
    "check:hostinger-bundle": "node scripts/check-hostinger-bundle.mjs",
    "auth:bootstrap-platform-admin": "node --experimental-strip-types scripts/bootstrap-platform-admin.ts",
    "stage8:test": "node --experimental-strip-types --test tests/stage8-*.test.ts",
    "stage8:worker": "node --experimental-strip-types scripts/stage8-worker.ts",
    "stage8:worker:health": "node --experimental-strip-types scripts/stage8-worker-health.ts"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "1.49.0",
    "@node-rs/argon2": "1.8.0",
    "@tailwindcss/postcss": "4.2.1",
    "@vitejs/plugin-react": "6.0.2",
    "drizzle-orm": "0.45.2",
    "next": "16.2.12",
    "pg": "8.16.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "redis": "6.1.0",
    "tailwindcss": "4.2.1",
    "vinext": "0.0.50",
    "vite": "8.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260801.1",
    "@types/node": "22.19.19",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.12",
    "react-server-dom-webpack": "19.2.8",
    "typescript": "5.9.3",
    "wrangler": "4.116.0"
  },
  "type": "module",
  "imports": {
    "#db-runtime": "./db/adapters/node-sqlite.ts"
  },
  "overrides": {
    "fast-uri": "3.1.4",
    "sharp": "0.35.3",
    "react-server-dom-webpack": "$react-server-dom-webpack",
    "postcss": "8.5.18",
    "workerd": "1.20260730.1"
  }
}
