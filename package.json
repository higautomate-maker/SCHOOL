{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "build:hostinger": "HIG_RUNTIME=node WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "node --experimental-strip-types scripts/validate-production-environment.ts && WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run test:unit",
    "test:unit": "node --experimental-strip-types --test tests/*.test.ts",
    "test:integration:infra": "node scripts/test-integration-infra.mjs",
    "test:integration:hostinger": "node scripts/test-hostinger-container.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build",
    "security:secrets": "node scripts/check-secrets.mjs",
    "security:licenses": "node scripts/check-licenses.mjs",
    "sbom": "npm sbom --sbom-format cyclonedx",
    "db:generate": "drizzle-kit generate",
    "db:pg:generate": "drizzle-kit generate --config drizzle.postgres.config.ts",
    "db:pg:migrate": "node scripts/migrate-postgres.mjs",
    "db:pg:migrate:check": "node scripts/migrate-postgres.mjs --check",
    "db:pg:backup:validate": "node scripts/validate-postgres-backup.mjs",
    "db:migrate:dry-run": "node --experimental-strip-types scripts/migrate-sqlite-to-postgres.ts",
    "db:migrate:execute": "node --experimental-strip-types scripts/migrate-sqlite-to-postgres.ts --execute",
    "db:reconcile": "node --experimental-strip-types scripts/reconcile-sqlite-postgres.ts",
    "test:load:postgres": "node --experimental-strip-types scripts/test-postgres-load.ts",
    "test:readiness:production": "node --experimental-strip-types scripts/test-stage5-readiness.ts",
    "validate:production": "node --experimental-strip-types scripts/validate-production-environment.ts",
    "db:pg:check": "node --experimental-strip-types --test tests/postgres-foundation.test.ts",
    "check:hostinger-bundle": "node scripts/check-hostinger-bundle.mjs"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@vitejs/plugin-react": "6.0.2",
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "pg": "8.16.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwindcss": "4.2.1",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@types/node": "22.19.19",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "typescript": "5.9.3",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
