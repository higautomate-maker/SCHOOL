# Local development only. Store hosted values in the deployment platform.
APP_URL=http://localhost:3000
SESSION_SECRET=replace-with-at-least-32-random-bytes
HIG_SECURITY_HASH_KEY=replace-with-a-different-32-random-byte-secret
DATABASE_URL=postgresql://hig_school:change-me@localhost:5432/hig_school
PG_POOL_MAX=10
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=10000
PG_SSL=disable
HIG_REPOSITORY_BACKEND=sqlite
HIG_POSTGRES_SHADOW_READS=false
HIG_DEMO_DB_PATH=.data/hig-school-demo.sqlite
REDIS_URL=redis://localhost:6379
HIG_QUEUE_MODE=redis
HIG_KEY_PROVIDER=environment
HIG_ENCRYPTION_KEY=replace-with-at-least-32-random-bytes
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
HIG_EMAIL_ADAPTER=smtp
SMTP_URL=smtps://smtp-user:replace-with-secret@smtp.example.com:465
SMTP_FROM=HIG School <security@example.com>
# Sales-demo deployments only. Supply JSON at deploy time; never commit accounts.
HIG_DEMO_ACCOUNTS_JSON=

# Stage 8 notification worker. Keep external delivery adapters disabled until
# a provider is intentionally configured; disabled attempts are tracked as skipped.
HIG_QUEUE_WORKER_ENABLED=false
HIG_QUEUE_BATCH_SIZE=20
HIG_QUEUE_CONCURRENCY=4
HIG_QUEUE_POLL_INTERVAL_MS=5000
HIG_QUEUE_LEASE_SECONDS=120
HIG_QUEUE_MAX_ATTEMPTS=6
HIG_QUEUE_RETRY_BASE_MS=5000
HIG_QUEUE_RETRY_MAX_MS=900000
HIG_QUEUE_HEARTBEAT_PATH=/tmp/hig-school-notification-worker-heartbeat.json
HIG_QUEUE_HEARTBEAT_MAX_AGE_MS=90000
HIG_NOTIFICATION_EMAIL_ADAPTER=disabled
HIG_SMS_ADAPTER=disabled
HIG_PUSH_ADAPTER=disabled
HIG_NOTIFICATION_CAPTURE_PATH=/tmp/hig-school-notification-capture.jsonl
